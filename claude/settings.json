{
  "permissions": {
    "allow": [
      "Read", "Edit", "Write", "Glob", "Grep", "WebSearch", "WebFetch",
      "Bash(ls:*)", "Bash(cat:*)", "Bash(head:*)", "Bash(tail:*)", "Bash(wc:*)",
      "Bash(mkdir:*)", "Bash(cp:*)", "Bash(mv:*)", "Bash(python3:*)", "Bash(python:*)",
      "Bash(pdflatex:*)", "Bash(latexmk:*)", "Bash(pandoc:*)", "Bash(pdftotext:*)", "Bash(bibtex:*)",
      "Bash(sage:*)", "Bash(gap:*)", "Bash(open:*)", "Bash(xdg-open:*)", "Bash(start:*)", "Bash(explorer:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)", "Bash(sudo:*)", "Bash(curl:*)", "Bash(wget:*)",
      "Bash(git push:*)", "Bash(ssh:*)", "Bash(chmod:*)",
      "Read(~/.ssh/**)", "Read(~/.aws/**)", "Read(~/.claude/**)"
    ]
  }
}
